---
import type { PROFILE } from "../../data/profile";

interface Props {
  profile: typeof PROFILE;
}

const { profile } = Astro.props;
const year = new Date().getUTCFullYear();
const links = [
  { label: "GitHub", href: profile.links.github },
  { label: "LinkedIn", href: profile.links.linkedin },
  { label: "Medium", href: profile.links.medium },
  { label: "Résumé", href: profile.links.resume },
];
---

<footer class="focus-on-cyan bg-primary text-primary-foreground">
  <div class="site-container py-14 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <div>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.16em]">Available on the open web</p>
        <p class="mt-4 max-w-[12ch] font-display text-5xl uppercase leading-[0.92] sm:text-7xl">Let’s build something useful.</p>
      </div>
      <nav aria-label="Contact links" class="grid grid-cols-2 border-l-[length:var(--border-width)] border-t-[length:var(--border-width)] border-black">
        {links.map((link) => (
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined} class="grid min-h-16 place-items-center border-b-[length:var(--border-width)] border-r-[length:var(--border-width)] border-black px-3 font-head font-bold text-black hover:bg-black hover:text-white">
            {link.label} {link.href.startsWith("http") ? "↗" : "↓"}
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-14 flex flex-wrap items-center justify-between gap-5 border-t-[length:var(--border-width)] border-black pt-5 font-mono text-xs font-bold uppercase">
      <p>© {year} {profile.name}. Built with Astro.</p>
      <a href="#home" class="min-h-11 py-3 underline decoration-2 underline-offset-4">Back to top ↑</a>
    </div>
  </div>
</footer>
