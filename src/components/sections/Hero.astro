---
import type { PROFILE } from "../../data/profile";
import Star from "../ui/Star.astro";

interface Props {
  profile: typeof PROFILE;
}

const { profile } = Astro.props;
---

<section id="home" aria-labelledby="hero-title" class="scroll-mt-36 border-b-[length:var(--border-width)] border-border">
  <div class="site-container grid min-h-[42rem] items-stretch lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)]">
    <div class="relative flex flex-col justify-center py-16 pr-0 lg:border-r-[length:var(--border-width)] lg:border-border lg:pr-12">
      <div class="mb-7 flex flex-wrap items-center gap-3">
        <span class="border-[length:var(--border-width)] border-border bg-primary px-3 py-1 font-mono text-xs font-bold uppercase tracking-[0.12em] text-primary-foreground shadow-sm">
          {profile.role}
        </span>
        <span class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">Bengaluru · India</span>
      </div>

      <h1 id="hero-title" class="max-w-[9ch] font-display text-[clamp(4rem,12vw,9.5rem)] leading-[0.82] uppercase tracking-[-0.075em]">
        <span class="block">Nikhil</span>
        <span class="mt-2 block w-fit bg-primary px-2 text-primary-foreground">Adiga</span>
      </h1>

      <p class="prose-width mt-9 text-xl font-medium leading-relaxed sm:text-2xl">
        {profile.statement}
      </p>

      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href="#projects"
          class="inline-flex min-h-12 items-center border-[length:var(--border-width)] border-border bg-primary px-5 py-2 font-head font-bold text-primary-foreground shadow-md transition-[transform,box-shadow] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-lg active:translate-x-[5px] active:translate-y-[5px] active:shadow-none"
        >
          See selected work ↓
        </a>
        <a
          href={profile.links.resume}
          class="inline-flex min-h-12 items-center border-[length:var(--border-width)] border-border bg-card px-5 py-2 font-head font-bold shadow-md transition-[transform,box-shadow] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-muted hover:shadow-lg active:translate-x-[5px] active:translate-y-[5px] active:shadow-none"
        >
          Read résumé ↗
        </a>
      </div>
    </div>

    <div class="relative grid min-h-[27rem] place-items-center overflow-hidden border-t-[length:var(--border-width)] border-border bg-primary p-8 lg:min-h-0 lg:border-t-0">
      <Star class="absolute left-5 top-5 text-5xl" />
      <Star class="absolute bottom-6 right-5 rotate-12 text-7xl" />
      <div class="relative w-full max-w-sm rotate-[1.5deg] border-[length:var(--border-width)] border-black bg-white p-3 shadow-[10px_10px_0_#000]">
        <img
          src={profile.portrait}
          alt={profile.portraitAlt}
          width="640"
          height="640"
          loading="eager"
          fetchpriority="high"
          class="aspect-square w-full border-[length:var(--border-width)] border-black object-cover object-top grayscale-[15%]"
        />
        <p class="mt-3 flex items-center justify-between font-mono text-xs font-bold uppercase text-black">
          <span>Profile / 2026</span><span>Build: stable</span>
        </p>
      </div>
    </div>
  </div>
</section>
