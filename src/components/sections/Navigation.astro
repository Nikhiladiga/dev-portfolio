---
import type { PROFILE, NAV_ITEMS } from "../../data/profile";
import DownloadIcon from "../ui/DownloadIcon.astro";

interface Props {
  profile: typeof PROFILE;
  items: typeof NAV_ITEMS;
}

const { profile, items } = Astro.props;
---

<header class="sticky top-0 z-40 border-b-[length:var(--border-width)] border-border bg-background/95 backdrop-blur-sm">
  <nav class="site-container flex flex-wrap items-center gap-x-3 gap-y-2 py-3" aria-label="Primary navigation">
    <a
      href="#home"
      class="flex min-h-11 shrink-0 items-center border-[length:var(--border-width)] border-border bg-primary px-3 font-display text-xl leading-none text-primary-foreground shadow-sm transition-transform hover:-translate-y-0.5"
      aria-label={`NA — ${profile.name}, back to top`}
    >
      NA<span class="sr-only"> — {profile.name}</span>
    </a>

    <div class="order-3 flex basis-full flex-wrap items-center gap-x-1 gap-y-1 md:order-2 md:basis-auto md:flex-1" aria-label="Page sections">
      {items.map((item) => (
        <a
          href={item.href}
          class="min-h-11 px-2 py-2 font-head text-sm font-bold underline-offset-4 hover:bg-muted hover:underline"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="order-2 ml-auto flex shrink-0 items-center gap-3 md:order-3">
      <a
        href={profile.links.resume}
        class="hidden min-h-11 items-center gap-1.5 font-mono text-xs font-bold uppercase underline decoration-2 underline-offset-4 hover:bg-muted sm:inline-flex"
      >
        Résumé <DownloadIcon />
      </a>
      <button
        type="button"
        class="group/button inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap border-[length:var(--border-width)] border-border bg-card px-3 py-1 font-head text-sm font-bold text-card-foreground shadow-md transition-[transform,box-shadow,background-color] duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-muted hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:translate-x-[5px] active:translate-y-[5px] active:shadow-none"
        aria-label="Switch theme"
        data-theme-toggle
      >
        <svg
          data-theme-icon="dark"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <svg
          data-theme-icon="light"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
          style="display: none"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <span data-theme-label>Dark</span>
      </button>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  function setButtonState(theme: "light" | "dark") {
    if (!button) return;
    const nextTheme = theme === "light" ? "dark" : "light";
    button.dataset.currentTheme = theme;
    button.setAttribute("aria-label", `Switch to ${nextTheme} theme`);
    const label = button.querySelector<HTMLElement>("[data-theme-label]");
    if (label) label.textContent = nextTheme === "dark" ? "Dark" : "Light";
    button.querySelectorAll<SVGElement>("[data-theme-icon]").forEach((icon) => {
      icon.style.display = icon.dataset.themeIcon === nextTheme ? "" : "none";
    });
  }

  if (button) {
    const initialTheme =
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    setButtonState(initialTheme);

    button.addEventListener("click", () => {
      const currentTheme =
        document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      const nextTheme = currentTheme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = nextTheme;
      setButtonState(nextTheme);
      try {
        localStorage.setItem("portfolio-theme", nextTheme);
      } catch {
        // The visual preference still applies to the current page.
      }
    });
  }
</script>
