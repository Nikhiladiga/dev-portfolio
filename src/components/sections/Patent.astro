---
import type { Patent } from "../../lib/types";
import Star from "../ui/Star.astro";

interface Props {
  patents: Patent[];
}

const { patents } = Astro.props;
const patent = patents[0];
---

{patent && (
  <section id="patent" aria-labelledby="patent-title" class="scroll-mt-36 border-b-[length:var(--border-width)] border-border bg-foreground py-20 text-background sm:py-28">
    <div class="site-container">
      <div class="grid gap-10 lg:grid-cols-[0.45fr_1.55fr]">
        <div class="flex items-start justify-between gap-5 lg:block">
          <div>
            <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-background/70">04 / Patent</p>
            <p class="mt-3 font-mono text-lg font-bold text-primary">{patent.number}</p>
          </div>
          <Star class="text-6xl lg:mt-14 lg:text-8xl" />
        </div>
        <div>
          <h2 id="patent-title" class="font-display text-4xl uppercase leading-[0.95] sm:text-6xl">{patent.title}</h2>
          <p class="prose-width mt-7 text-lg text-background/75">{patent.description}</p>
          <a href={patent.url} target="_blank" rel="noreferrer" class="mt-8 inline-flex min-h-12 items-center border-[length:var(--border-width)] border-background bg-primary px-5 py-2 font-head font-bold text-primary-foreground shadow-[5px_5px_0_var(--paper)] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5">
            Read on Google Patents ↗
          </a>
        </div>
      </div>
    </div>
  </section>
)}
