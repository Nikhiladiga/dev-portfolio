---
import type { Project } from "../../lib/types";
import ExternalLinkIcon from "../ui/ExternalLinkIcon.astro";
import Star from "../ui/Star.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" aria-labelledby="projects-title" class="scroll-mt-36 border-b-[length:var(--border-width)] border-border bg-muted py-20 sm:py-28">
  <div class="site-container">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">02 / Selected work</p>
        <h2 id="projects-title" class="mt-2 font-display text-5xl uppercase leading-none sm:text-7xl">Projects</h2>
      </div>
      <Star class="text-6xl sm:text-8xl" />
    </div>

    <div class="grid gap-7 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project, index) => (
        <article class:list={["flex min-h-[24rem] flex-col border-[length:var(--border-width)] border-border bg-card p-6 shadow-md"]}>
          <div class="flex items-start justify-between gap-4">
            <p class="font-mono text-xs font-bold uppercase text-muted-foreground">{String(index + 1).padStart(2, "0")} / {project.repository}</p>
            <span class="border-[length:var(--border-width)] border-border bg-primary px-2 py-0.5 font-mono text-[0.65rem] font-bold uppercase text-primary-foreground">Build</span>
          </div>
          <h3 class="mt-8 font-display text-3xl uppercase leading-[0.95] sm:text-4xl">{project.title}</h3>
          <p data-project-description class="mt-5 max-w-[52ch] text-base text-muted-foreground">{project.description}</p>

          <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${project.title} technologies`}>
            {project.technologies.map((technology) => (
              <li class="border-2 border-border bg-background px-2 py-1 font-mono text-[0.65rem] font-bold uppercase">{technology}</li>
            ))}
          </ul>

          {project.stats && (
            <dl data-project-stats="visible" class="mt-6 flex flex-wrap gap-x-5 gap-y-2 border-t-2 border-border pt-4 font-mono text-xs font-bold">
              <div class="flex gap-1"><dt>Stars</dt><dd>{project.stats.stars}</dd></div>
              <div class="flex gap-1"><dt>Forks</dt><dd>{project.stats.forks}</dd></div>
              <div class="flex gap-1"><dt>Watchers</dt><dd>{project.stats.watchers}</dd></div>
            </dl>
          )}

          <div class="mt-auto flex flex-wrap gap-4 pt-8 font-head font-bold">
            <a href={project.repositoryUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 underline decoration-2 underline-offset-4 hover:bg-primary hover:text-primary-foreground">
              GitHub <ExternalLinkIcon /><span class="sr-only"> for {project.title}</span>
            </a>
            {project.demoUrl && (
              <a href={project.demoUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 underline decoration-2 underline-offset-4 hover:bg-primary hover:text-primary-foreground">
                {project.demoUrl.includes("npmjs.com") ? "npm" : "Live demo"} <ExternalLinkIcon /><span class="sr-only"> for {project.title}</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
