---
import type { PortfolioStats } from "../../lib/types";

interface Props {
  stats: PortfolioStats;
}

const { stats } = Astro.props;
const items = [
  { label: "Public repositories", value: stats.publicRepositories },
  { label: "Patent", value: stats.patents },
  { label: "Open-source projects", value: stats.openSourceProjects },
  { label: "Published articles", value: stats.articles },
];
---

<section id="stats" aria-labelledby="stats-title" class="scroll-mt-36 border-b-[length:var(--border-width)] border-border bg-card">
  <h2 id="stats-title" class="sr-only">Portfolio at a glance</h2>
  <div class="site-container grid grid-cols-2 lg:grid-cols-4">
    {items.map((item, index) => (
      <div class:list={["px-4 py-8 sm:px-6", index % 2 === 0 && "border-r-[length:var(--border-width)] border-border", index < 2 && "border-b-[length:var(--border-width)] border-border lg:border-b-0", index > 0 && "lg:border-l-[length:var(--border-width)] lg:border-border", index === 2 && "lg:border-l-0"]}>
        <p class="font-display text-4xl leading-none sm:text-5xl">{String(item.value).padStart(2, "0")}</p>
        <p class="mt-3 font-mono text-[0.7rem] font-bold uppercase leading-snug tracking-[0.1em] text-muted-foreground">{item.label}</p>
      </div>
    ))}
  </div>
</section>
