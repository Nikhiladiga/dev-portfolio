---
import { ArrowUpRight } from "lucide-react";

interface Props {
  class?: string;
  size?: number;
}

const { class: className = "size-[1em]", size = 18 } = Astro.props;
---

<ArrowUpRight
  data-external-link-icon="true"
  className={`inline-block shrink-0 ${className}`}
  size={size}
  strokeWidth={2.5}
  aria-hidden="true"
/>
